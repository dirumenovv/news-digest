<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2933;">
<div style="display:none;max-height:0;overflow:hidden;">{{totalItems}} item(s) for {{dateLabel}}</div>
<div style="max-width:600px;margin:0 auto;padding:24px 16px;">
  <div style="background:#1f3a5f;color:#ffffff;padding:24px;border-radius:8px 8px 0 0;">
    <h1 style="margin:0;font-size:22px;">{{title}}</h1>
    <p style="margin:6px 0 0;font-size:14px;color:#d5e1f0;">{{dateLabel}}</p>
  </div>
  <div style="background:#ffffff;padding:8px 24px 24px;border-radius:0 0 8px 8px;">
    {{#if isEmpty}}
    <p style="font-size:15px;">No new items today.</p>
    {{/if}}
    {{#each sections}}
    <h2 style="margin:24px 0 12px;font-size:16px;color:#1f3a5f;border-bottom:2px solid #e4e7eb;padding-bottom:6px;"><span style="display:inline-block;vertical-align:-4px;margin-right:8px;">{{{icon}}}</span>{{title}}</h2>
    {{#each items}}
    <div style="margin:0 0 14px;{{#if ../isWeather}}background:#eef4fb;padding:12px;border-radius:6px;{{/if}}">
      <div style="font-size:15px;font-weight:600;line-height:1.35;">
        {{#if url}}<a href="{{url}}" style="color:#1f3a5f;text-decoration:none;">{{title}}</a>{{else}}{{title}}{{/if}}
      </div>
      {{#if summary}}<div style="margin-top:4px;font-size:14px;line-height:1.5;color:#3e4c59;">{{summary}}</div>{{/if}}
      {{#if meta}}<div style="margin-top:4px;font-size:12px;color:#7b8794;">{{meta}}</div>{{/if}}
    </div>
    {{/each}}
    {{/each}}
    {{#if hasUnavailable}}
    <p style="margin-top:24px;font-size:12px;color:#9aa5b1;">Some sources were unavailable today: {{#each unavailable}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}.</p>
    {{/if}}
  </div>
  <p style="text-align:center;font-size:12px;color:#9aa5b1;margin-top:16px;">Generated by Daily Digest</p>
</div>
</body>
</html>
