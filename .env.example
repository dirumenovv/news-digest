# Copy to .env and fill in. Never commit .env.
LOG_LEVEL=info

# SMTP (required unless running with --dry-run)
# Mailtrap Email Sandbox: Email Testing > Sandboxes > your sandbox > Integration tab > SMTP.
# Messages are captured in the sandbox and never delivered to real recipients.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-sandbox-username
SMTP_PASS=your-mailtrap-sandbox-password
# Any address works as the sender in the sandbox
MAIL_FROM="Daily Digest <digest@example.com>"

# Optional
LLM_API_KEY=
GITHUB_TOKEN=
